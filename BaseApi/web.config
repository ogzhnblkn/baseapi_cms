<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAV modülünü tamamen kaldır -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      
      <!-- Handler'ları düzenle -->
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      
      <!-- Request filtering - PUT/DELETE'e açık izin ver -->
      <security>
        <requestFiltering>
          <verbs allowUnlisted="true">
            <add verb="GET" allowed="true" />
            <add verb="POST" allowed="true" />
            <add verb="PUT" allowed="true" />
            <add verb="DELETE" allowed="true" />
            <add verb="PATCH" allowed="true" />
            <add verb="OPTIONS" allowed="true" />
            <add verb="HEAD" allowed="true" />
          </verbs>
          <!-- File size limits -->
          <requestLimits maxAllowedContentLength="52428800" maxUrl="4096" maxQueryString="2048" />
        </requestFiltering>
      </security>
      
      <!-- ASP.NET Core ayarları -->
      <aspNetCore processPath="dotnet" 
                  arguments=".\BaseApi.dll" 
                  stdoutLogEnabled="true" 
                  stdoutLogFile=".\logs\stdout" 
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="1" />
        </environmentVariables>
      </aspNetCore>
      
      <!-- URL Rewrite modülü varsa PUT'a müdahale etmesin -->
      <rewrite>
        <rules>
          <clear />
        </rules>
      </rewrite>
      
    </system.webServer>
  </location>
  
  <!-- Global system.web ayarları -->
  <system.web>
    <httpRuntime maxRequestLength="51200" executionTimeout="300" />
  </system.web>
  
</configuration>
